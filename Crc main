# Define a local directory for ledger and chat files
LEDGER_DIR = '/content/CraftcoinData'
os.makedirs(LEDGER_DIR, exist_ok=True)

# Define file paths
LOG_FILE = os.path.join(LEDGER_DIR, 'log.txt')
CHAT_FILE = os.path.join(LEDGER_DIR, 'cha.txt')
ADDR_FILE = os.path.join(LEDGER_DIR, 'addr.json')

def get_ledger_content():
  try:
    with open(LOG_FILE, 'r') as f:
      return f.read()
  except FileNotFoundError:
    return "File Not Found (or no entries yet)"

def get_chat_content():
  try:
    with open(CHAT_FILE, 'r') as z:
      return z.read()
  except FileNotFoundError:
    return "File Not Found (or no chat yet)"

def led(message):
  time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
  timestamped_message = f"[{time}] {message}"
  try:
    with open(LOG_FILE, 'a') as f:
      f.write(timestamped_message + '\n')
  except IOError as e:
      return f"Error writing to {LOG_FILE}: {e}"
  return timestamped_message

def crc(mess):
  time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
  timestamped_message = f"[{time}] {mess}"
  try:
    with open(CHAT_FILE, 'a') as z:
      z.write(timestamped_message + '\n')
  except IOError as tt:
    return f"Error writing to {CHAT_FILE}: {tt}"
  return timestamped_message

def ee():
  po = random.randint(1,10000)
  return po

def blco():
  global m
  if 'm' not in globals():
    m = 0
  m += 1
  return m

def generate_random_sha256():
    random_bytes = os.urandom(32)
    return hashlib.sha256(random_bytes).hexdigest()

def hash_password(password):
    return hashlib.sha256(password.encode()).hexdigest()

if 'users' not in globals():
    users = {
        'a': {'password': hash_password('1'), 'address': 'a'},
        'b': {'password': hash_password('2'), 'address': 'b'},
