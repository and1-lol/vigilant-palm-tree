def load_addr():
    global addr
    try:
        with open(ADDR_FILE, 'r') as f:
            addr = json.load(f)
        return "Balances loaded."
    except FileNotFoundError:
        addr = {
            'a': 0,
            'b': 0,
            'c': 0
        }
        save_addr()
        return "'" + ADDR_FILE + "' not found. Initializing new balances."
    except json.JSONDecodeError:
        addr = {
            'a': 0,
            'b': 0,
            'c': 0
        }
        save_addr()
        return "Error decoding '" + ADDR_FILE + "'. File might be corrupted. Initializing new balances."

load_addr()

def perform_transfer(username, password, recipient_address, transfer_amount_str):
    global current_user, addr
    load_addr() 
    
    hashed_pw = hash_password(password)

    if username in users and users[username]['password'] == hashed_pw:
        current_user = username
        sender_account_key = username

        if recipient_address not in addr:
            return "Invalid recipient address."

        if recipient_address == sender_account_key:
            return "Cannot transfer to yourself."

        try:
            transfer_amount = float(transfer_amount_str)
        except ValueError:
            return "Invalid amount. Please enter a number."

        if transfer_amount <= 0:
            return "Transfer amount must be positive."

        if addr.get(sender_account_key, 0) >= transfer_amount:
            addr[sender_account_key] -= transfer_amount
            addr[recipient_address] += transfer_amount
            blco()
            led(f'Transaction {m}: {sender_account_key} sent {transfer_amount} Craftcoin to {recipient_address}')
            save_addr()
            return "Transfer Successful!"
        else:
            return "Insufficient Funds"
    else:
        return "Authentication Failed."

def scout_craftcoin_logic(scout_input_str, recipient_address):
    global addr
    po = ee() 

    try:
        scout_input = int(scout_input_str)
        if scout_input == po:
            if recipient_address in addr:
                addr[recipient_address] += 20
                blco()
                led(f'{m}: Scouted 20 Craftcoin for ({recipient_address}) by entering ({po})')
                save_addr()
                return f"Scouted 20 Craftcoin for {recipient_address}!"
            else:
                return "Invalid address for receiving Craftcoin."
        else:
            return "Incorrect number. Invalid Request."
    except ValueError:
        return "Invalid input for scouting number. Please enter a number."

def get_balance(address):
    load_addr()
    if address in addr:
        return f"({address}) has {addr.get(address)} Craftcoin"
    else:
        return "Invalid Address"

def send_chat_message(message):
    result = crc(message)
    if "Error" in result: # Check if crc returned an error message
        return result
    return "Message sent to chat."


class CraftcoinGUI:
    def __init__(self, master):
        self.master = master
        master.title("CraftcoinV3.0")
        master.geometry("700x500") # Increased window size

        self.current_user = None # Initialize current_user for the GUI session

        # --- Frames --- 
        self.menu_frame = tk.Frame(master, padx=10, pady=10)
        self.menu_frame.pack(side=tk.LEFT, fill=tk.Y)

        self.content_frame = tk.Frame(master, padx=10, pady=10)
        self.content_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

        self.create_menu_buttons()
        self.create_welcome_page()

    def clear_content_frame(self):
        for widget in self.content_frame.winfo_children():
            widget.destroy()

    def show_message(self, title, message):
        messagebox.showinfo(title, message)

    def create_menu_buttons(self):
        tk.Label(self.menu_frame, text="----Menu----").pack(pady=5)

        buttons = [
            ("To Scout", self.show_scout_page),
            ("Transfer", self.show_transfer_page),
            ("CRC Chat", self.show_chat_page),
            ("Ledger..", self.show_ledger_page),
            ("Disclaim", self.show_disclaimer_page),
            ("CheckCRC", self.show_check_balance_page),
            ("Test N/A", self.show_test_page)
        ]

        for text, command in buttons:
            tk.Button(self.menu_frame, text=text, command=command, width=15).pack(pady=2)
        
        tk.Label(self.menu_frame, text="").pack(pady=5) # Spacer
        tk.Label(self.menu_frame, text="Logged in as:").pack()
        self.user_label = tk.Label(self.menu_frame, text="Guest")
        self.user_label.pack()

    def update_user_label(self, username):
        self.user_label.config(text=username if username else "Guest")

    def create_welcome_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Welcome to CraftcoinV3.0", font=("Arial", 16)).pack(pady=20)
        tk.Label(self.content_frame, text="NOTICE: This webpage is not at all affiliated with the other crypto currency 'Craftcoin' (the one for minecraft servers)", wraplength=400).pack(pady=10)

    def show_scout_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Scout Craftcoin", font=("Arial", 14)).pack(pady=10)

        tk.Label(self.content_frame, text="Enter a number to scout:").pack()
        self.scout_num_entry = tk.Entry(self.content_frame)
        self.scout_num_entry.pack(pady=5)

        tk.Label(self.content_frame, text="Recipient Address (a, b, or c):").pack()
        self.scout_recipient_entry = tk.Entry(self.content_frame)
        self.scout_recipient_entry.pack(pady=5)

        tk.Button(self.content_frame, text="Scout", command=self.perform_scout).pack(pady=10)
        self.scout_result_label = tk.Label(self.content_frame, text="")
        self.scout_result_label.pack()

    def perform_scout(self):
        scout_num = self.scout_num_entry.get()
        recipient = self.scout_recipient_entry.get().strip().lower()
        result = scout_craftcoin_logic(scout_num, recipient)
        self.scout_result_label.config(text=result)
        if "Scouted" in result: # If successful, refresh balance for current user (if logged in)
            if self.current_user: 
                balance_msg = get_balance(self.current_user)
                messagebox.showinfo("Balance Updated", f"Your balance: {balance_msg}")


    def show_transfer_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Secure Transfer", font=("Arial", 14)).pack(pady=10)

        tk.Label(self.content_frame, text="Username:").pack()
        self.transfer_username_entry = tk.Entry(self.content_frame)
        self.transfer_username_entry.pack(pady=5)

        tk.Label(self.content_frame, text="Password:").pack()
        self.transfer_password_entry = tk.Entry(self.content_frame, show="*")
        self.transfer_password_entry.pack(pady=5)

        tk.Label(self.content_frame, text="Recipient Address (a, b, or c):").pack()
        self.transfer_recipient_entry = tk.Entry(self.content_frame)
        self.transfer_recipient_entry.pack(pady=5)

        tk.Label(self.content_frame, text="Amount to Transfer:").pack()
        self.transfer_amount_entry = tk.Entry(self.content_frame)
        self.transfer_amount_entry.pack(pady=5)

        tk.Button(self.content_frame, text="Transfer", command=self.initiate_transfer).pack(pady=10)
        self.transfer_result_label = tk.Label(self.content_frame, text="")
        self.transfer_result_label.pack()

    def initiate_transfer(self):
        username = self.transfer_username_entry.get().strip()
        password = self.transfer_password_entry.get().strip()
        recipient = self.transfer_recipient_entry.get().strip().lower()
        amount = self.transfer_amount_entry.get().strip()

        result = perform_transfer(username, password, recipient, amount)
        self.transfer_result_label.config(text=result)
        self.show_message("Transfer Result", result)
        if "Successful" in result: # On successful transfer, update current user and display balance
            self.current_user = username
            self.update_user_label(self.current_user)
            balance_msg = get_balance(self.current_user)
            messagebox.showinfo("Balance Updated", f"Your new balance: {balance_msg}")

    def show_chat_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="CRC Chat", font=("Arial", 14)).pack(pady=10)

        self.chat_display = scrolledtext.ScrolledText(self.content_frame, width=60, height=15, state='disabled')
        self.chat_display.pack(pady=10)
        self.update_chat_display()

        tk.Label(self.content_frame, text="Enter a new message:").pack()
        self.chat_message_entry = tk.Entry(self.content_frame, width=50)
        self.chat_message_entry.pack(pady=5)

        tk.Button(self.content_frame, text="Send Message", command=self.send_chat_gui).pack(pady=10)

    def update_chat_display(self):
        chat_content = get_chat_content()
        self.chat_display.config(state='normal')
        self.chat_display.delete('1.0', tk.END)
        self.chat_display.insert(tk.END, chat_content)
        self.chat_display.config(state='disabled')
        self.chat_display.see(tk.END)

    def send_chat_gui(self):
        message = self.chat_message_entry.get().strip()
        if message:
            result = send_chat_message(message)
            self.show_message("Chat Message", result)
            self.chat_message_entry.delete(0, tk.END)
            self.update_chat_display()
        else:
            self.show_message("Error", "Message cannot be empty.")

    def show_ledger_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Ledger", font=("Arial", 14)).pack(pady=10)

        self.ledger_display = scrolledtext.ScrolledText(self.content_frame, width=60, height=20, state='disabled')
        self.ledger_display.pack(pady=10)
        self.update_ledger_display()

    def update_ledger_display(self):
        ledger_content = get_ledger_content()
        self.ledger_display.config(state='normal')
        self.ledger_display.delete('1.0', tk.END)
        self.ledger_display.insert(tk.END, ledger_content + "\n*End of Ledger*")
        self.ledger_display.config(state='disabled')
        self.ledger_display.see(tk.END)

    def show_disclaimer_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Disclaimer", font=("Arial", 14)).pack(pady=10)
        disclaimer_text = "Craftcoin Semi-Centralized is not responsible for any loss of assets or expenses during use of this program. Hackers can and will be removed by the community. To apply for an account ask me in real life so I can add you."
        tk.Label(self.content_frame, text=disclaimer_text, wraplength=400, justify=tk.LEFT).pack(pady=10)

    def show_check_balance_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Check Account Balance", font=("Arial", 14)).pack(pady=10)

        tk.Label(self.content_frame, text="Enter Address (a, b, or c):").pack()
        self.check_balance_entry = tk.Entry(self.content_frame)
        self.check_balance_entry.pack(pady=5)

        tk.Button(self.content_frame, text="Check Balance", command=self.display_balance).pack(pady=10)
        self.balance_result_label = tk.Label(self.content_frame, text="")
        self.balance_result_label.pack()

    def display_balance(self):
        address = self.check_balance_entry.get().strip().lower()
        result = get_balance(address)
        self.balance_result_label.config(text=result)

    def show_test_page(self):
        self.clear_content_frame()
        tk.Label(self.content_frame, text="Test Page", font=("Arial", 14)).pack(pady=10)
        tk.Label(self.content_frame, text="This is to test stuff: No tests active").pack()
        # Optionally log this test activity
        led("GUI Test Page Viewed")
        tk.Label(self.content_frame, text="Test Complete").pack()


if __name__ == '__main__':
    root = tk.Tk()
    app = CraftcoinGUI(root)
    root.mainloop()
